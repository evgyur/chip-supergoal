{
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "sent", "kind", "pack_version", "goal_id", "contract_sha256", "contract_revision", "target", "files", "hashes", "message_ids", "reservation_id", "sent_at"],
  "properties": {
    "ok": {"const": true},
    "sent": {"const": true},
    "kind": {"const": "review-md-files"},
    "pack_version": {"const": "review_pack_v2"},
    "goal_id": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "contract_revision": {"type": "integer", "minimum": 1},
    "target": {"type": "string", "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[^/\\\\\\r\\n]+$"},
      "allOf": [
        {"contains": {"const": "THINKING.md"}},
        {"contains": {"const": "LOOP_DESIGN.md"}},
        {"contains": {"const": "ROADMAP.md"}},
        {"contains": {"const": "LAUNCH_GOAL.md"}}
      ]
    },
    "hashes": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "message_ids": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\r\\n\\u0000]+$"}},
    "reservation_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "sent_at": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"},
    "extensions": {"type": "object"}
  }
}
