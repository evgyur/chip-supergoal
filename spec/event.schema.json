{
  "$id": "https://hermes.local/chip-supergoal/event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "minLength": 1,
      "type": "string"
    },
    "contract_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "contract_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "event_id": {
      "pattern": "^EVT-[0-9]{6}$",
      "type": "string"
    },
    "event_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "goal_id": {
      "minLength": 1,
      "type": "string"
    },
    "phase_id": {
      "minLength": 1,
      "type": "string"
    },
    "prev_event_sha256": {
      "oneOf": [
        {"type": "null"},
        {"pattern": "^[a-f0-9]{64}$", "type": "string"}
      ]
    },
    "state_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "state": {
      "$ref": "state.schema.json"
    },
    "state_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "goal_id",
    "contract_sha256",
    "contract_revision",
    "state_revision",
    "state_sha256",
    "state",
    "event_type",
    "phase_id",
    "actor",
    "timestamp",
    "evidence_ids",
    "prev_event_sha256",
    "event_sha256"
  ],
  "title": "chip-supergoal event",
  "type": "object"
}
