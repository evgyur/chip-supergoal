{
  "$id": "https://hermes.local/chip-supergoal/contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approvals": {
      "type": "array"
    },
    "architecture": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    },
    "contract_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "decisions": {
      "type": "array"
    },
    "delivery": {
      "type": "object"
    },
    "goal": {
      "type": "object"
    },
    "loop": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "outcome_definition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "evidence", "threshold", "in_scope", "out_of_scope", "stop_and_ask"],
          "properties": {
            "outcome": {"type": "string", "minLength": 1},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "threshold": {"type": "string", "minLength": 1},
            "in_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "out_of_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "stop_and_ask": {"type": "string", "minLength": 1}
          }
        },
        "execution_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "planner_effort", "integrator_effort", "engineering_mode", "worker_model", "worker_mode", "max_parallel_scouts", "max_review_rounds", "phase_routes"],
          "properties": {
            "owner": {"const": "Sol"},
            "planner_effort": {"enum": ["high", "max"]},
            "integrator_effort": {"enum": ["high", "max"]},
            "engineering_mode": {"const": "shawl"},
            "worker_model": {"const": "gpt-5.6-luna"},
            "worker_mode": {"const": "scout"},
            "max_parallel_scouts": {"type": "integer", "minimum": 1, "maximum": 3},
            "max_review_rounds": {"type": "integer", "minimum": 1, "maximum": 3},
            "phase_routes": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["direct", "shawl"]}}
          }
        }
      },
      "required": ["outcome_definition", "execution_profile"]
    },
    "phases": {
      "minItems": 1,
      "type": "array"
    },
    "profile": {
      "minLength": 1,
      "type": "string"
    },
    "protocol_version": {
      "const": "3.0"
    },
    "risks": {
      "type": "array"
    },
    "schema_version": {
      "const": "3.0"
    },
    "source_set": {
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "protocol_version",
    "contract_revision",
    "profile",
    "goal",
    "source_set",
    "decisions",
    "architecture",
    "loop",
    "risks",
    "approvals",
    "phases",
    "delivery",
    "compatibility"
  ],
  "title": "chip-supergoal CONTRACT v3",
  "type": "object"
}
