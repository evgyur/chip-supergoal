{
  "$id": "https://hermes.local/chip-supergoal/state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "enum": ["AUDITING", "DONE"]
          }
        },
        "required": ["lifecycle"]
      },
      "then": {
        "properties": {
          "blocker": {"type": "null"},
          "phase_status": {"const": "COMPLETE"}
        }
      }
    }
  ],
  "properties": {
    "attempt": {
      "minimum": 0,
      "type": "integer"
    },
    "audit_round": {
      "minimum": 0,
      "type": "integer"
    },
    "blocker": {
      "type": [
        "object",
        "null"
      ]
    },
    "contract_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "contract_revision": {
      "minimum": 1,
      "type": "integer"
    },
    "current_phase_id": {
      "minLength": 1,
      "type": "string"
    },
    "goal_id": {
      "minLength": 1,
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "COMPILED",
        "PLAN_REVIEWED",
        "PREFLIGHT_GREEN",
        "READY_TO_DISPATCH",
        "RUNNING",
        "RECOVERING",
        "AUDITING",
        "WAITING_APPROVAL",
        "WAITING_EXTERNAL",
        "HANDOFF",
        "DONE"
      ]
    },
    "phase_status": {
      "enum": [
        "PENDING",
        "READY",
        "EXECUTING",
        "VERIFYING",
        "BLOCKED",
        "COMPLETE"
      ]
    },
    "schema_version": {
      "const": "3.0"
    },
    "state_revision": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "goal_id",
    "contract_sha256",
    "contract_revision",
    "state_revision",
    "lifecycle",
    "current_phase_id",
    "phase_status",
    "blocker",
    "attempt",
    "audit_round"
  ],
  "title": "chip-supergoal STATE v3",
  "type": "object"
}
